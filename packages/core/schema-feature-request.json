{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.software-factory.example/feature-request.schema.json",
  "title": "Software Factory Feature Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "campaignId",
    "revision",
    "previousRevisionHash",
    "status",
    "profile",
    "title",
    "source",
    "owner",
    "requestedBy",
    "businessOutcome",
    "nonGoals",
    "acceptanceCriteria",
    "risk",
    "workItems",
    "contracts",
    "trafficEdges",
    "dependencyGraph",
    "requiredChecks",
    "observability",
    "security",
    "approvalPolicy",
    "budgets",
    "unresolved",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^FR-[A-Z0-9-]+$"
    },
    "campaignId": {
      "type": "string",
      "pattern": "^SF-[0-9]{4}-[0-9]{4,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previousRevisionHash": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "awaiting_approval",
        "approved",
        "superseded",
        "rejected"
      ]
    },
    "profile": {
      "$ref": "#/$defs/profileRef"
    },
    "title": {
      "$ref": "#/$defs/nonEmpty"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "owner": {
      "$ref": "#/$defs/actor"
    },
    "requestedBy": {
      "$ref": "#/$defs/actor"
    },
    "businessOutcome": {
      "$ref": "#/$defs/nonEmpty"
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmpty"
      },
      "uniqueItems": true
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "risk": {
      "$ref": "#/$defs/risk"
    },
    "workItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workItem"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "trafficEdges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trafficEdge"
      }
    },
    "dependencyGraph": {
      "$ref": "#/$defs/dependencyGraph"
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/checkRequirement"
      }
    },
    "observability": {
      "$ref": "#/$defs/observability"
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "approvalPolicy": {
      "$ref": "#/$defs/approvalPolicy"
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved"
      }
    },
    "createdAt": {
      "$ref": "#/$defs/dateTime"
    },
    "updatedAt": {
      "$ref": "#/$defs/dateTime"
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "team",
            "factory"
          ]
        },
        "id": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "url"
      ],
      "properties": {
        "kind": {
          "enum": [
            "feature_spec",
            "free_form"
          ]
        },
        "reference": {
          "$ref": "#/$defs/nonEmpty"
        },
        "url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[0-9]+$"
        },
        "statement": {
          "$ref": "#/$defs/nonEmpty"
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "signals",
        "rationale"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "signals": {
          "type": "array",
          "items": {
            "enum": [
              "secrets",
              "authentication",
              "authorization",
              "pii",
              "api_contract",
              "event_contract",
              "database_migration",
              "network_policy",
              "irreversible_operation"
            ]
          },
          "uniqueItems": true
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repositoryId",
        "repositoryUrl",
        "baseBranch",
        "baseSha",
        "purpose",
        "writePaths",
        "generatedPaths",
        "dependsOn"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WI-[a-z0-9-]+$"
        },
        "repositoryId": {
          "$ref": "#/$defs/id"
        },
        "repositoryUrl": {
          "type": "string",
          "format": "uri"
        },
        "baseBranch": {
          "$ref": "#/$defs/nonEmpty"
        },
        "baseSha": {
          "oneOf": [
            {
              "$ref": "#/$defs/gitSha"
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "$ref": "#/$defs/nonEmpty"
        },
        "writePaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          },
          "uniqueItems": true
        },
        "generatedPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          },
          "uniqueItems": true
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WI-[a-z0-9-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "providerWorkItem",
        "consumerWorkItems",
        "sourcePath",
        "compatibility",
        "sourceSha",
        "artifactDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CONTRACT-[a-z0-9-]+$"
        },
        "kind": {
          "enum": [
            "http_openapi",
            "pact",
            "event",
            "database",
            "configuration",
            "network_policy"
          ]
        },
        "providerWorkItem": {
          "type": "string",
          "pattern": "^WI-[a-z0-9-]+$"
        },
        "consumerWorkItems": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WI-[a-z0-9-]+$"
          },
          "uniqueItems": true
        },
        "sourcePath": {
          "$ref": "#/$defs/nonEmpty"
        },
        "compatibility": {
          "enum": [
            "backward_compatible",
            "expand_migrate_contract",
            "breaking_approved"
          ]
        },
        "sourceSha": {
          "oneOf": [
            {
              "$ref": "#/$defs/gitSha"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifactDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "trafficIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "serviceAccount",
        "namespace",
        "host"
      ],
      "properties": {
        "service": {
          "$ref": "#/$defs/nonEmpty"
        },
        "serviceAccount": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmpty"
            },
            {
              "type": "null"
            }
          ]
        },
        "namespace": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmpty"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmpty"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "trafficEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workItem",
        "environment",
        "source",
        "destination",
        "methods",
        "paths",
        "port",
        "protocol",
        "classification",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TRAFFIC-[a-z0-9-]+$"
        },
        "workItem": {
          "type": "string",
          "pattern": "^WI-[a-z0-9-]+$"
        },
        "environment": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/trafficIdentity"
        },
        "destination": {
          "$ref": "#/$defs/trafficIdentity"
        },
        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS"
            ]
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          },
          "uniqueItems": true
        },
        "port": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol": {
          "enum": [
            "HTTP",
            "HTTPS",
            "HTTP2",
            "GRPC",
            "TCP",
            "TLS"
          ]
        },
        "classification": {
          "enum": [
            "internal",
            "external",
            "regulated"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "dependencyGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WI-[a-z0-9-]+$"
          },
          "uniqueItems": true
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "kind",
              "condition"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^WI-[a-z0-9-]+$"
              },
              "to": {
                "type": "string",
                "pattern": "^WI-[a-z0-9-]+$"
              },
              "kind": {
                "enum": [
                  "contract",
                  "generation",
                  "build",
                  "review",
                  "test",
                  "cleanup"
                ]
              },
              "condition": {
                "$ref": "#/$defs/nonEmpty"
              }
            }
          }
        }
      }
    },
    "checkRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workItem",
        "kind",
        "required",
        "executor",
        "deferTo"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CHECK-[a-z0-9-]+$"
        },
        "workItem": {
          "type": "string",
          "pattern": "^WI-[a-z0-9-]+$"
        },
        "kind": {
          "$ref": "#/$defs/id"
        },
        "required": {
          "type": "boolean"
        },
        "executor": {
          "enum": [
            "sandbox",
            "reviewer",
            "human"
          ]
        },
        "deferTo": {
          "oneOf": [
            {
              "enum": [
                "human"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedSignals",
        "traceQueries",
        "logQueries",
        "metricQueries",
        "piiLogScan"
      ],
      "properties": {
        "expectedSignals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "traceQueries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "logQueries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "metricQueries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "piiLogScan": {
          "type": "boolean"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataClasses",
        "allowedEgress",
        "credentialClasses",
        "prohibitedLogging",
        "requiredReviews"
      ],
      "properties": {
        "dataClasses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "allowedEgress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          },
          "uniqueItems": true
        },
        "credentialClasses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "prohibitedLogging": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "requiredReviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "expiryMinutes",
        "invalidateOn"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "expiryMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "invalidateOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxCostUsd",
        "maxElapsedMinutes",
        "maxConcurrentBuilders",
        "maxRepairCyclesPerRepository",
        "maxStorageMiB"
      ],
      "properties": {
        "maxCostUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxElapsedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "maxConcurrentBuilders": {
          "type": "integer",
          "minimum": 1
        },
        "maxRepairCyclesPerRepository": {
          "type": "integer",
          "minimum": 0
        },
        "maxStorageMiB": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "jsonPointer",
        "question",
        "owner",
        "blocksState",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^UNRESOLVED-[a-z0-9-]+$"
        },
        "jsonPointer": {
          "type": "string",
          "pattern": "^/"
        },
        "question": {
          "$ref": "#/$defs/nonEmpty"
        },
        "owner": {
          "$ref": "#/$defs/actor"
        },
        "blocksState": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "wont_resolve"
          ]
        }
      }
    }
  }
}
