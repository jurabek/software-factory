{
  "name": "@sumup/software-factory-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "software-factory": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config apps/visualizer/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc --noEmit -p apps/visualizer/tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "visualize": "tsx src/cli.ts visualize"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@lucide/vue": "^1.37.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "minimatch": "^10.2.6",
    "typebox": "^1.3.22",
    "vue": "^3.5.42",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
