# Server-only deployment configuration. Never use NEXT_PUBLIC_ for these values.
# Next loads .env.local; the migration command uses the same environment loader.
# Builds need none of these values. The runtime setup page validates their shape,
# not provider credentials, owner identity, database connectivity, or migrations.
APPLICATION_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://factory:local-password@localhost:5432/factory_application
INITIAL_OWNER_EMAIL=
# Generate a random secret of at least 32 characters. Do not reuse this example.
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production APPLICATION_ORIGIN must be HTTPS. No daemon config is needed yet.
# Run npm run migrations explicitly before serving database-backed functionality.
# Migrations only require DATABASE_URL and must target a separate application DB.
# Under docker-compose.yaml the database host is "postgres"; DATABASE_URL is
# wired there, so local development keeps using localhost above.
