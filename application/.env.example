# Server-only deployment configuration. Never use NEXT_PUBLIC_ for these values.
# Next loads .env.local; the migration command uses the same environment loader.
# Builds need none of these values. The runtime setup page validates their shape,
# not login correctness, database connectivity, or migrations.
APPLICATION_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://factory:local-password@localhost:5432/factory_application
INITIAL_USER_LOGIN=owner
# Use at least 12 characters. This value stays server-side and is never persisted.
INITIAL_USER_PASSWORD=replace-with-at-least-12-characters
# Generate 32 random bytes as 64 hexadecimal characters. Rotating this key
# requires re-registering daemons.
DAEMON_CREDENTIAL_KEY=
# Exact comma-separated daemon origins. Hosts must be IP addresses (or localhost)
# to prevent DNS rebinding. Paths, credentials, query strings, and redirects fail.
DAEMON_ALLOWED_ORIGINS=http://127.0.0.1:8080
# Production APPLICATION_ORIGIN must be HTTPS.
# Run npm run application:migrations before serving database-backed functionality.
# The idempotent schema command supports fresh and existing application databases.
# It only requires DATABASE_URL and must target a separate application database.
# Under docker-compose.yaml the database host is "postgres"; DATABASE_URL is
# wired there, so local development keeps using localhost above.
