# Docker Compose deployment settings. Copy to .env and replace every placeholder.
POSTGRES_USER=factory
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=factory_application
APPLICATION_PORT=3000
APPLICATION_ORIGIN=http://localhost:3000
INITIAL_USER_LOGIN=owner
INITIAL_USER_PASSWORD=replace-with-at-least-12-characters
# Generate with: openssl rand -hex 32
DAEMON_CREDENTIAL_KEY=replace-with-64-hexadecimal-characters
# Exact daemon tunnel origins reachable from the application container.
DAEMON_ALLOWED_ORIGINS=http://192.0.2.10:8080
