{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sumup.example/software-factory/agent-result.schema.json",
  "title": "Software Factory Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultId",
    "campaignId",
    "requestRevision",
    "requestHash",
    "profile",
    "workItemId",
    "role",
    "workerRunId",
    "piSessionId",
    "status",
    "inputs",
    "plan",
    "decisions",
    "unresolved",
    "changedFiles",
    "contractChanges",
    "trafficChanges",
    "commands",
    "checks",
    "findings",
    "risks",
    "artifacts",
    "gitState",
    "nextActions",
    "summary",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "resultId": { "type": "string", "format": "uuid" },
    "campaignId": { "type": "string", "pattern": "^SF-[0-9]{4}-[0-9]{4,}$" },
    "requestRevision": { "type": "integer", "minimum": 1 },
    "requestHash": { "$ref": "#/$defs/sha256" },
    "profile": { "$ref": "#/$defs/profileRef" },
    "workItemId": { "oneOf": [{ "type": "string", "pattern": "^WI-[a-z0-9-]+$" }, { "type": "null" }] },
    "role": { "enum": ["planner", "builder", "reviewer", "tester"] },
    "workerRunId": { "$ref": "#/$defs/nonEmpty" },
    "piSessionId": { "$ref": "#/$defs/nonEmpty" },
    "status": { "enum": ["completed", "changes_requested", "blocked", "failed", "budget_exhausted", "cancelled"] },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "plan": { "oneOf": [{ "$ref": "#/$defs/plan" }, { "type": "null" }] },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" } },
    "changedFiles": { "type": "array", "items": { "$ref": "#/$defs/changedFile" } },
    "contractChanges": { "type": "array", "items": { "$ref": "#/$defs/changeRef" } },
    "trafficChanges": { "type": "array", "items": { "$ref": "#/$defs/changeRef" } },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "gitState": { "oneOf": [{ "$ref": "#/$defs/gitState" }, { "type": "null" }] },
    "nextActions": { "type": "array", "items": { "$ref": "#/$defs/nextAction" } },
    "summary": { "$ref": "#/$defs/nonEmpty" },
    "startedAt": { "$ref": "#/$defs/dateTime" },
    "completedAt": { "$ref": "#/$defs/dateTime" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "digest", "classification"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "reference": { "$ref": "#/$defs/nonEmpty" },
        "digest": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "classification": { "enum": ["internal", "confidential", "transcript", "release"] }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workItems", "dependencyEdges", "requiredChecks", "requiredApprovals"],
      "properties": {
        "workItems": { "type": "array", "items": { "type": "string", "pattern": "^WI-[a-z0-9-]+$" } },
        "dependencyEdges": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "requiredChecks": { "type": "array", "items": { "type": "string", "pattern": "^CHECK-[a-z0-9-]+$" } },
        "requiredApprovals": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "basis", "reversible", "approvalRequired"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/nonEmpty" },
        "basis": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "reversible": { "type": "boolean" },
        "approvalRequired": { "type": "boolean" }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "blocking", "owner", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "$ref": "#/$defs/nonEmpty" },
        "blocking": { "type": "boolean" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "change", "purpose", "generated", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "change": { "enum": ["added", "modified", "deleted", "renamed"] },
        "purpose": { "$ref": "#/$defs/nonEmpty" },
        "generated": { "type": "boolean" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "changeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "compatibility", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/id" },
        "compatibility": { "enum": ["unchanged", "backward_compatible", "expand_migrate_contract", "breaking_approved"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "cwd", "startedAt", "completedAt", "exitCode", "outcome", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "command": { "$ref": "#/$defs/nonEmpty" },
        "cwd": { "$ref": "#/$defs/nonEmpty" },
        "startedAt": { "$ref": "#/$defs/dateTime" },
        "completedAt": { "$ref": "#/$defs/dateTime" },
        "exitCode": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
        "outcome": { "enum": ["passed", "failed", "cancelled", "timed_out"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "status", "required", "attempt", "failureClass", "evidence", "waiverId"],
      "properties": {
        "checkId": { "type": "string", "pattern": "^CHECK-[a-z0-9-]+$" },
        "status": { "enum": ["passed", "failed", "deferred", "waived"] },
        "required": { "type": "boolean" },
        "attempt": { "type": "integer", "minimum": 1 },
        "failureClass": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "waiverId": { "oneOf": [{ "type": "string", "pattern": "^WAIVER-[a-z0-9-]+$" }, { "type": "null" }] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "category", "summary", "rationale", "location", "blocking", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "category": { "$ref": "#/$defs/id" },
        "summary": { "$ref": "#/$defs/nonEmpty" },
        "rationale": { "$ref": "#/$defs/nonEmpty" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "line"],
          "properties": {
            "path": { "$ref": "#/$defs/nonEmpty" },
            "line": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
          }
        },
        "blocking": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "statement", "mitigation", "blocking", "evidence"],
      "properties": {
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "statement": { "$ref": "#/$defs/nonEmpty" },
        "mitigation": { "$ref": "#/$defs/nonEmpty" },
        "blocking": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "gitState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "baseBranch", "baseSha", "branch", "headSha", "clean", "commitShas", "pullRequestUrl"],
      "properties": {
        "repositoryId": { "$ref": "#/$defs/id" },
        "baseBranch": { "$ref": "#/$defs/nonEmpty" },
        "baseSha": { "$ref": "#/$defs/gitSha" },
        "branch": { "$ref": "#/$defs/nonEmpty" },
        "headSha": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "clean": { "type": "boolean" },
        "commitShas": { "type": "array", "items": { "$ref": "#/$defs/gitSha" } },
        "pullRequestUrl": { "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }] }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "ownerRole", "preconditions"],
      "properties": {
        "action": { "$ref": "#/$defs/nonEmpty" },
        "ownerRole": { "enum": ["developer", "planner", "builder", "reviewer", "tester", "controller"] },
        "preconditions": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    }
  }
}
