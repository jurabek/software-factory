{
  "$schema": "../DOMAIN_PROFILE.schema.json",
  "schemaVersion": "1.0.0",
  "id": "local",
  "version": "1.0.0",
  "name": "Local",
  "extends": [],
  "owners": [
    { "role": "engineering", "identity": "local-developer" }
  ],
  "repositories": [
    {
      "id": "app",
      "url": "https://github.com/example/app",
      "defaultBranch": "main",
      "adapter": "local-git",
      "mode": "read_write",
      "instructionPaths": ["AGENTS.md", "README.md"],
      "defaultWritePaths": ["**"],
      "generatedPaths": [],
      "checkIds": ["app-unit", "app-lint"]
    }
  ],
  "riskDefaults": {
    "highRiskSignals": [
      "authentication or authorization",
      "secrets or credentials",
      "data-store contract",
      "destructive rollback"
    ],
    "prohibitedEvidenceData": [
      "credentials or tokens",
      "secrets",
      "complete request or response payloads containing secrets"
    ]
  },
  "requiredReviewKinds": ["spec", "standards", "codeowners"],
  "approvalRules": [
    { "id": "multi-repository-plan", "when": "more than one work item exists", "approval": "plan" },
    { "id": "break-glass", "when": "a normally read-only repository write is requested", "approval": "break-glass" }
  ],
  "deliveryProviders": [
    { "kind": "ci", "adapter": "local-ci", "access": "read_only" },
    { "kind": "artifact", "adapter": "campaign-artifact-store", "access": "approved_write" }
  ],
  "evaluationScenarios": [
    {
      "id": "implement-requested-change",
      "description": "Plan, implement, review, and test a change in the selected repositories",
      "expectedRepositories": ["app"],
      "requiredFindings": ["request coverage", "repository standards"],
      "prohibitedBehavior": ["writes outside approved paths", "treating a missing check as passed"]
    }
  ]
}
